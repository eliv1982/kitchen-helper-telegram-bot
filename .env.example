BOT_TOKEN=your_telegram_bot_token_here
OPENAI_API_KEY=your_openai_api_key_here

OPENAI_MODEL=gpt-4.1-mini
# A reasoning model (gpt-6-luna): also set OPENAI_REASONING_EFFORT=low (required for gpt-6*, TEMPERATURE is then
# not sent) and MAX_TOKENS around 6000 (it caps reasoning + answer together).
# OPENAI_REASONING_EFFORT=low
TEMPERATURE=0.7
MAX_TOKENS=1000
OPENAI_TIMEOUT_SECONDS=15
OPENAI_MAX_RETRIES=1

# Structured recipes (the sentinel-delimited protocol parsed by house_helper.core.recipes).
# Off by default and kept off until the protocol is validated with the provider: with it off
# the prompt and the answers are exactly as before, legacy favorites keep working, and stored
# structured favorites are still read, edited and removed. 1/true/on/yes or 0/false/off/no.
# HOUSE_HELPER_STRUCTURED_RECIPES=0
