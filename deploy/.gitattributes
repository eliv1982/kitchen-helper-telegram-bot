# Shell scripts run on the Linux host: a Windows checkout must never turn their line endings
# into CRLF (bash would then fail on the first line). The runbook runs them as `bash script.sh`,
# so no executable bit is needed either.
*.sh text eol=lf
# The same for the systemd units and their environment template (R4C-D2): systemd reads them
# on the Linux host, and a CRLF would end up inside a value or a command line.
systemd/* text eol=lf
# The off-host backup runs on the Linux host as `python3 deploy/offsite_backup.py`.
offsite_backup.py text eol=lf
# The restore rehearsal runs on the owner's own machine (any OS) but its text is the same text everywhere.
offsite_rehearsal.py text eol=lf
