# House Helper: when to take the encrypted off-host backup. Opt-in: nothing installs or enables this;
# see deploy/RUNBOOK.md section 15 and house-helper-offsite-backup.service.
#
# Once a day at 04:15 UTC (05:15 or 06:15 in the Netherlands), spread over the next ten minutes: after
# the cleanup of expired data (house-helper-purge.timer, 03:30 UTC plus up to five minutes), so that a
# point is made from the database as the cleanup left it. To change the time do NOT edit this file in
# /etc: add a drop-in with
#     sudo systemctl edit house-helper-offsite-backup.timer
# containing
#     [Timer]
#     OnCalendar=
#     OnCalendar=*-*-* 04:45:00 UTC
# (the empty line first clears the schedule below; without it the two are added together).
# `systemd-analyze calendar '*-*-* 04:45:00 UTC'` shows when a spelling would next fire.
#
# Retention counts recovery points, not days: 7 daily and 4 weekly. A schedule other than daily changes
# what that covers (a point every other day keeps two weeks of dailies) and how long a deleted
# conversation can survive in an off-host copy (section 15.2).

[Unit]
Description=Daily House Helper encrypted off-host backup (timer)

[Timer]
OnCalendar=*-*-* 04:15:00 UTC
RandomizedDelaySec=10min
AccuracySec=1min
# Missed-run recovery: if the host was off or this timer was not running at 04:15, the run happens
# once, as soon as the timer next starts. Never one run per missed day.
Persistent=true
Unit=house-helper-offsite-backup.service

[Install]
WantedBy=timers.target
