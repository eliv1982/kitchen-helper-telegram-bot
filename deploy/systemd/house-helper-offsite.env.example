# The environment of house-helper-offsite-backup.service. A TEMPLATE: it holds no secret, only
# paths and the name of a remote. Install it as /etc/house-helper/offsite.env (root-owned, mode 0644)
# and fill in the values. The access token of the remote is NOT here: it is in the rclone config file
# named below, which is mode 0600 and root-only.
#
# The checkout (HOUSE_HELPER_CHECKOUT) and the tag of the RUNNING image (HOUSE_HELPER_IMAGE_TAG) come
# from /etc/house-helper/purge.env, which the service reads first. Keep them there, in one place: the
# step after every upgrade and every rollback is the same edit for the cleanup and for this backup.
#
# No quotes, no spaces around the equals sign, no spaces in the values. systemd reads this file itself
# (it is not a shell script).

# age PUBLIC keys, one per line (lines starting with # are comments), at most eight. Only keys that
# start with age1 are accepted, and a file that contains a private key (AGE-SECRET-KEY-...) is refused:
# the private key must never be on this host. Generate the pair on the owner's own machine.
HOUSE_HELPER_AGE_RECIPIENTS_FILE=/etc/house-helper/age-recipients.txt

# The rclone configuration of the dedicated Yandex Disk application folder, mode 0600. The tool passes
# it with --config and ignores RCLONE_* variables of the environment.
HOUSE_HELPER_RCLONE_CONFIG=/etc/house-helper/rclone.conf

# NAME:FOLDER. NAME is the remote in the file above; FOLDER is a folder of its own inside the
# application folder, where this tool creates, reads and deletes its recovery points and nothing else.
# A bare NAME: (the root of the remote) is refused.
HOUSE_HELPER_OFFSITE_REMOTE=REPLACE_WITH_THE_REMOTE_NAME:house-helper

# How far the OAuth token of the remote reaches. Leave it as it is: app-folder is the design (the token reaches
# the Yandex application folder only; the config says app_folder = true).
# The one other value, full-disk-temporary, is a TEMPORARY exception that needs the owner's explicit decision,
# a token that reaches the WHOLE disk, a config WITHOUT app_folder, and the remote above set to exactly
# NAME:house-helper-backup (no other folder is accepted in that mode). Read deploy/RUNBOOK.md 15.12 first,
# and go back to app-folder as soon as a stable rclone with the Yandex app_folder option exists.
HOUSE_HELPER_OFFSITE_ACCESS_MODE=app-folder
