# House Helper: when to delete what has expired (R4C-D2). Opt-in: nothing installs or enables
# this; see deploy/RUNBOOK.md section 14 and house-helper-purge.service.
#
# Once a day, at 03:30 UTC (04:30 or 05:30 in the Netherlands), spread over the next five
# minutes. To change the cadence do NOT edit this file in /etc: add a drop-in with
#     sudo systemctl edit house-helper-purge.timer
# containing
#     [Timer]
#     OnCalendar=
#     OnCalendar=*-*-* 04:15:00 UTC
# (the empty line first clears the schedule below; without it the two are added together).
# `systemd-analyze calendar '*-*-* 04:15:00 UTC'` shows when a spelling would next fire.
#
# Timing is a tolerance, not a guarantee: a row is deleted by the first SUCCESSFUL run after
# the moment it expired, so it can outlive its deadline by about the interval between runs,
# plus however long a failing run goes unfixed. Reads hide it from the moment it expires.

[Unit]
Description=Daily House Helper cleanup of expired data (timer)

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=5min
AccuracySec=1min
# Missed-run recovery: if the host was off or this timer was not running at 03:30, the run
# happens once, as soon as the timer next starts (systemd keeps the time of the last run in
# /var/lib/systemd/timers/stamp-house-helper-purge.timer). Never one run per missed day.
Persistent=true
Unit=house-helper-purge.service

[Install]
WantedBy=timers.target
