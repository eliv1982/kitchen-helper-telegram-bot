# The environment of house-helper-purge.service. A TEMPLATE: it holds no secret, only two paths
# and an image tag. Install it as /etc/house-helper/purge.env (root-owned, mode 0644), fill in
# the three values, and keep it in step with the version that is running (RUNBOOK section 14).
#
# No quotes, no spaces around the equals sign, no spaces in the paths. systemd reads this file
# itself (it is not a shell script and not Compose's env file).

# The checkout that deploy/compose.yaml is in (the runbook's convention: ~/apps/house_helper).
# An absolute path.
HOUSE_HELPER_CHECKOUT=/home/OPERATOR/apps/house_helper

# The same file the web service uses (HOUSE_HELPER_ENV_FILE of the runbook). Compose insists that
# the file named for the web service exist before it will start any service of the project. The
# operator one-shot gets NO environment file and never reads this one; only its path is given
# here, never its content.
HOUSE_HELPER_ENV_FILE=/home/OPERATOR/deploy-overlays/secrets/house-helper.env

# The tag of the image that is RUNNING (what `docker compose ps` shows for house-helper). The
# command refuses a database that is not at its schema head (exit 4): change this after every
# upgrade and every rollback, in the same step as the upgrade.
HOUSE_HELPER_IMAGE_TAG=REPLACE_WITH_THE_RUNNING_TAG
