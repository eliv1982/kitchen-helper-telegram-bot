# The environment of house-helper-purge.service. A TEMPLATE: it holds no secret, only paths,
# an activation value and an image tag. Install it as /etc/house-helper/purge.env
# (root-owned, mode 0644), fill in the values, and keep it in step with the version that is
# running (deploy/postgres/scheduled_maintenance.md).
#
# No quotes, no spaces around the equals sign, no spaces in the paths. systemd reads this
# file itself. It is ALSO the file Compose is given with `--env-file` for every manual
# command (deploy/postgres/scheduled_maintenance.md, section 3.5): one file, so the manual
# and scheduled runs resolve the same approved values. That is only safe because it carries
# no credential - never add a password, a token or a DSN here; the passfiles are mounted
# read-only, not read from the environment.

# The checkout that deploy/compose.postgres.yaml is in (the PostgreSQL deployment layout).
# An absolute path.
HOUSE_HELPER_CHECKOUT=/home/OPERATOR/apps/house_helper

# The same file the web service uses (HOUSE_HELPER_ENV_FILE of the runbook). Compose insists that
# the file named for the web service exist before it will start any service of the project. The
# purge one-shot gets NO environment file and never reads this one; only its path is given here,
# never its content.
HOUSE_HELPER_ENV_FILE=/home/OPERATOR/deploy-overlays/secrets/house-helper.env

# The tag of the image that is RUNNING (what `docker compose ps` shows for house-helper). The
# retention command refuses a database that is not at its schema head (exit 4): change this
# after every upgrade and every rollback, in the same step as the upgrade.
HOUSE_HELPER_IMAGE_TAG=REPLACE_WITH_THE_RUNNING_TAG

# The PostgreSQL surface's deliberate-activation guard. The compose file refuses to resolve a
# one-shot without exactly 1, and every one-shot checks it again at runtime. Never set it for a
# stack that is not the PostgreSQL deployment.
HOUSE_HELPER_PG_ACTIVATE=1

# The host directory holding the per-role passfiles; the purge service mounts ONLY
# hh_purge.pgpass from it, read-only. Absolute path, mode 0700 directory, mode 0600 files.
HOUSE_HELPER_PG_CREDENTIALS_DIR=/home/OPERATOR/deploy-overlays/secrets/pg-credentials

# The canonical host journal directory of the PostgreSQL cutover (HH-DB-01 LCK-09). It is
# root-owned 0700 and is NOT mounted into the purge container. The one-time H3 `hh_purge`
# CONNECT handoff is journaled here by deploy/postgres/enroll.py, and the offsite backup tool
# passes this same directory to deploy/postgres/maintenance.py.
HOUSE_HELPER_PG_JOURNAL_DIR=/var/lib/house-helper/cutover
